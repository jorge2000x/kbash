#!/usr/bin/env bash
# Pós-instalação do Fedora "Super Poderoso Caseiro 2026" (Fedora 44), portado para kbash.
# Fonte: guia do rentry "fedorasuperpoderoso".
#
# Como a interação está organizada neste exemplo:
#   - OPÇÕES são valores que você escolhe no formulário (placa de vídeo, compressão do
#     zram, escalonador eBPF). Nenhuma opção liga ou desliga uma ação.
#   - STEPS são as ações marcadas na lista. O checkbox é que decide o que roda.
#     Não há perguntas escondidas dentro dos steps.
#   - A tela de revisão do plano é a única confirmação. Depois dela, o diálogo de
#     autenticação (polkit) aparece uma vez, antes do primeiro step root.
#
# O que mudou em relação ao guia:
#   - o `reboot` virou o step final "Reiniciar ao final", que começa desmarcado;
#   - o bloco de DNS do guia tinha `&& \` antes do heredoc, o que faz o conteúdo do
#     arquivo ser executado como comando. Aqui o heredoc está na forma correta;
#   - `flatpak remote-delete fedora` só roda se o remote existir;
#   - sem `sudo` nos comandos: o privilégio vem da elevação do kbash (SPEC.md §9.2).
#
#@runtime 1
#@name Fedora Super Poderoso
#@description Pós-instalação do Fedora 44: repositórios, codecs, drivers, Flatpak e ajustes opcionais.
#@version 1.1.0
#@author Guia de rentry "fedorasuperpoderoso" (portado)
#@requires dnf,flatpak,systemctl

# ---------------------------------------------------------------------------
# Opções: valores escolhidos no formulário.
# ---------------------------------------------------------------------------
#@option gpu type=choice label="Placa de vídeo" choices="nenhuma,nvidia,amd,intel-nova,intel-antiga" default=nenhuma help="Usada pelo passo 'Drivers de vídeo'."
#@option nvidia_secure_boot_off type=bool label="Confirmo que o Secure Boot está desligado" default=false help="Obrigatório para instalar o driver NVIDIA. Com Secure Boot ligado, siga o guia do RPM Fusion."
#@option zram_tamanho type=choice label="Tamanho do zram" choices="ram,ram / 2" default=ram help="ram para 8 GB de RAM; ram / 2 para 16 GB ou mais. Usado pelo passo 'Configurar zram'."
#@option zram_compressao type=choice label="Compressão do zram" choices="lz4,zstd" default=lz4 help="lz4 é mais rápido e o padrão do guia; zstd comprime melhor. Usado pelo passo 'Configurar zram'."
#@option scx_sched type=choice label="Escalonador eBPF" choices="scx_lavd,scx_bpfland,scx_rusty,scx_cosmos" default=scx_lavd help="Usado pelo passo 'Scheduler eBPF'. lavd é o do guia; bpfland é uma alternativa mais leve para desktop."

# ---------------------------------------------------------------------------
# Funções auxiliares
# ---------------------------------------------------------------------------
# Opção booleana marcada. A GUI envia 1/0 (SPEC §4.3); a CLI pode enviar true/false.
ativo() {
    case "$1" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Essencial (marcados por padrão)
# ---------------------------------------------------------------------------
#@step atualizar_sistema
#@title Atualizar o sistema
#@desc Atualiza todos os pacotes do sistema.
#@group Essencial
#@root true
atualizar_sistema() {
    dnf upgrade --refresh -y
}

#@step repos_rpmfusion
#@title Repositórios RPM Fusion
#@desc Habilita Free, Nonfree e Tainted, com metadados para a loja de apps.
#@group Essencial
#@depends atualizar_sistema
#@root true
repos_rpmfusion() {
    # Etapa 1: Free e Nonfree (instala direto via URL)
    dnf install -y \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"

    # Etapa 2: Tainted (agora que os repositórios estão disponíveis)
    dnf install -y rpmfusion-free-release-tainted rpmfusion-nonfree-release-tainted

    # Metadados para o GNOME Software/Discover mostrarem apps do RPM Fusion
    dnf install -y rpmfusion-free-appstream-data rpmfusion-nonfree-appstream-data
}

#@step dnf_paralelo
#@title Downloads paralelos no DNF
#@desc Configura o DNF para 10 downloads simultâneos.
#@group Essencial
#@depends repos_rpmfusion
#@root true
dnf_paralelo() {
    dnf config-manager setopt parallel_downloads=10
}

#@step codecs
#@title Codecs de multimídia
#@desc Troca o ffmpeg-free pelo completo e instala os codecs essenciais.
#@group Codecs
#@depends repos_rpmfusion
#@root true
codecs() {
    # Trocar ffmpeg-free pelo ffmpeg completo
    dnf swap -y ffmpeg-free ffmpeg --allowerasing

    # Grupo de codecs do RPM Fusion
    dnf groupupdate -y multimedia --setopt="install_weak_deps=False" --exclude=PackageKit-gstreamer-plugin

    # Codecs essenciais
    dnf install -y x264 x265 fdk-aac pipewire-codec-aptx libldac svt-av1
    dnf install -y gstreamer1-plugins-bad-freeworld gstreamer1-libav
    dnf install -y mozilla-openh264 gstreamer1-plugin-openh264
}

#@step firmwares
#@title Atualizar firmwares
#@desc Atualiza os firmwares pelo fwupd.
#@group Firmware
#@root true
firmwares() {
    fwupdmgr refresh
    fwupdmgr update
}

#@step drivers_gpu
#@title Drivers de vídeo
#@desc Instala o driver da placa escolhida na opção "Placa de vídeo".
#@group Drivers
#@depends repos_rpmfusion
#@root true
drivers_gpu() {
    case "$OPT_GPU" in
        nvidia)
            if ! ativo "$OPT_NVIDIA_SECURE_BOOT_OFF"; then
                rt_warn "NVIDIA não instalado: marque 'Secure Boot desligado' nas opções para liberar."
                return 0
            fi
            dnf install -y akmod-nvidia
            dnf install -y xorg-x11-drv-nvidia-cuda
            rt_notify "Espere uns 15 minutos para o driver compilar e depois reinicie."
            ;;
        amd)
            dnf install -y mesa-va-drivers-freeworld
            ;;
        intel-nova)
            # Intel 11ª geração ou mais nova, e Arc
            dnf install -y intel-media-driver
            ;;
        intel-antiga)
            # Intel 10ª geração ou anterior
            dnf install -y libva-intel-driver
            ;;
        *)
            rt_log "drivers de vídeo: nenhuma placa escolhida, nada a fazer"
            ;;
    esac
}

#@step configurar_flatpak
#@title Configurar o Flathub
#@desc Adiciona o Flathub e remove o remote padrão do Fedora.
#@group Flatpak
#@root true
configurar_flatpak() {
    flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    flatpak remote-modify --enable flathub
    if flatpak remote-list | grep -q '^fedora'; then
        flatpak remote-delete fedora --force
    else
        rt_log "remote 'fedora' já não existe"
    fi
}

#@step snapshots
#@title Snapshots Btrfs
#@desc Instala o Btrfs Assistant, útil para voltar o sistema se algo quebrar.
#@group Essencial
#@root true
snapshots() {
    dnf install -y btrfs-assistant
}

#@step essenciais
#@title Pacotes essenciais
#@desc Pacotes do sistema e apps Flatpak do guia.
#@group Essencial
#@depends configurar_flatpak
#@root true
essenciais() {
    dnf install -y webkit2gtk4.1 gtk3 librsvg2 libappindicator-gtk3 exfatprogs ntfs-3g fuse fuse-libs fastfetch
    flatpak install -y flathub it.mijorus.gearlever
    flatpak install -y flathub io.github.flattool.Warehouse
    flatpak install -y flathub com.github.tchx84.Flatseal
    flatpak install -y flathub io.missioncenter.MissionCenter
}

#@step limpeza
#@title Limpeza final
#@desc Remove dependências órfãs e o cache do DNF.
#@group Essencial
#@depends essenciais
#@root true
limpeza() {
    dnf autoremove -y
    dnf clean all
}

# ---------------------------------------------------------------------------
# Hardware específico (desmarcados por padrão)
# ---------------------------------------------------------------------------
#@step dvd_passo
#@title Decodificação de DVD e Blu-ray
#@desc Bibliotecas para ler discos protegidos. Quase ninguém precisa.
#@group Hardware
#@depends repos_rpmfusion
#@default off
#@root true
dvd_passo() {
    dnf install -y libdvdcss libaacs libbdplus
}

#@step firmware_wifi_broadcom
#@title Firmware de Wi-Fi Broadcom
#@desc Só para placas Wi-Fi Broadcom.
#@group Hardware
#@default off
#@root true
firmware_wifi_broadcom() {
    dnf install -y b43-firmware
}

#@step firmware_bt_broadcom
#@title Firmware de Bluetooth Broadcom
#@desc Só para adaptadores Bluetooth Broadcom.
#@group Hardware
#@default off
#@root true
firmware_bt_broadcom() {
    dnf install -y broadcom-bt-firmware
}

# ---------------------------------------------------------------------------
# Extras opinativos (desmarcados por padrão; o guia diz que não são essenciais)
# ---------------------------------------------------------------------------
#@step scheduler_ebpf_passo
#@title Scheduler eBPF
#@desc Instala o escalonador escolhido em "Escalonador eBPF" e o inicia com o sistema.
#@group Extras
#@default off
#@root true
scheduler_ebpf_passo() {
    dnf copr enable -y bieszczaders/kernel-cachyos-addons
    dnf install -y scx-scheds scx-tools

    mkdir -p /etc/scx_loader
    tee /etc/scx_loader/config.toml > /dev/null << EOF
default_sched = "$OPT_SCX_SCHED"
default_mode = "Auto"
EOF
    systemctl enable --now scx_loader.service
}

#@step preempt_lazy_passo
#@title Kernel com preempt=lazy
#@desc Troca um pouco de desempenho por latência. Precisa de kernel 6.13+. Vale no próximo boot.
#@group Extras
#@default off
#@root true
preempt_lazy_passo() {
    grubby --update-kernel=ALL --args="preempt=lazy"
    rt_notify "Depois do boot: sudo dmesg | grep -i 'dynamic preempt' (deve mostrar lazy)"
}

#@step zram_passo
#@title Configurar zram
#@desc Tamanho e compressão do zram, conforme as opções "Tamanho do zram" e "Compressão do zram".
#@group Extras
#@default off
#@root true
zram_passo() {
    local tamanho="ram"
    [ "$OPT_ZRAM_TAMANHO" = "ram / 2" ] && tamanho="ram / 2"
    mkdir -p /etc/systemd/zram-generator.conf.d
    tee /etc/systemd/zram-generator.conf.d/custom.conf > /dev/null << EOF
[zram0]
zram-size = $tamanho
compression-algorithm = $OPT_ZRAM_COMPRESSAO
EOF
}

#@step sysctl_zram_passo
#@title Ajuste de memória (sysctl)
#@desc Ajustes de swap e cache. Só faz diferença com 8 GB de RAM.
#@group Extras
#@default off
#@root true
sysctl_zram_passo() {
    tee /etc/sysctl.d/99-zram-tuning.conf > /dev/null << 'EOF'
vm.swappiness = 100
vm.page-cluster = 0
vm.vfs_cache_pressure = 135
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
vm.watermark_scale_factor = 15
vm.min_free_kbytes = 185072
vm.watermark_boost_factor = 0
EOF
    sysctl --system
}

#@step dns_adguard_passo
#@title DNS AdGuard via TLS
#@desc Troca o DNS da rede pelo AdGuard, com DNS sobre TLS. Frágil: se a rede falhar, remova /etc/systemd/resolved.conf.d/adguard.conf.
#@group Extras
#@default off
#@root true
dns_adguard_passo() {
    mkdir -p /etc/systemd/resolved.conf.d
    tee /etc/systemd/resolved.conf.d/adguard.conf > /dev/null << 'EOF'
[Resolve]
DNS=94.140.14.14#dns.adguard-dns.com 94.140.15.15#dns.adguard-dns.com
DNSOverTLS=yes
DNSSEC=allow-downgrade
EOF
    systemctl restart systemd-resolved
}

#@step boot_rapido_passo
#@title Não esperar a rede no boot
#@desc Desabilita o NetworkManager-wait-online. Normalmente não tem efeito colateral.
#@group Extras
#@default off
#@root true
boot_rapido_passo() {
    systemctl disable NetworkManager-wait-online.service
}

#@step io_scheduler_passo
#@title Scheduler de I/O por tipo de disco
#@desc Regras udev: none para NVMe, mq-deadline para SSD SATA e bfq para HDD.
#@group Extras
#@default off
#@root true
io_scheduler_passo() {
    tee /etc/udev/rules.d/60-nvme-scheduler.rules > /dev/null << 'EOF'
# NVMe: sem scheduler, o controle é feito pelo próprio drive
ACTION=="add|change", KERNEL=="nvme[0-9]*", ATTR{queue/scheduler}="none"
EOF
    tee /etc/udev/rules.d/62-ssd-scheduler.rules > /dev/null << 'EOF'
# SSD SATA: mq-deadline é simples e eficiente
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"
EOF
    tee /etc/udev/rules.d/61-hdd-scheduler.rules > /dev/null << 'EOF'
# HDD: bfq prioriza latência e é bom para discos mecânicos
ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
EOF
    udevadm control --reload-rules && udevadm trigger
}

#@step fish_passo
#@title Shell fish
#@desc Troca o shell do seu usuário pelo fish. Muitos scripts que dependem do bash podem quebrar.
#@group Extras
#@default off
#@root true
fish_passo() {
    dnf install -y fish
    dnf install -y util-linux-user
    command -v fish | tee -a /etc/shells > /dev/null
    chsh -s /usr/bin/fish "$USER"
}

#@step cstate_passo
#@title Limitar C-state (AMD)
#@desc Adiciona processor.max_cstate=1. Workaround para certos hardwares AMD; provavelmente desnecessário em outras máquinas.
#@group Extras
#@default off
#@root true
cstate_passo() {
    grubby --update-kernel=ALL --args="processor.max_cstate=1"
}

#@step fontes_passo
#@title Fontes melhores
#@desc Instala o freetype do RPM Fusion para renderização de fontes melhor.
#@group Extras
#@default off
#@root true
fontes_passo() {
    dnf install -y freetype-freeworld
}

# ---------------------------------------------------------------------------
# Final
# ---------------------------------------------------------------------------
#@step reiniciar_passo
#@title Reiniciar ao final
#@desc Reinicia o computador quando o script terminar. Marque só se quiser aplicar tudo agora.
#@group Final
#@default off
#@root true
reiniciar_passo() {
    reboot
}
